# Whatsupp Prototype — environment variables
# Copy to .env.local and fill in.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Models
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_MODEL_FAST=claude-sonnet-4-6
OPENAI_MODEL_COMPARE=gpt-5
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar

# Storage
DATABASE_PATH=./data/whatsupp.db
